{
  "info": {
    "name": "API Express + MongoDB - Clase 9",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "productoId",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Crear producto",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const r = pm.response.json();",
              "if (r.data && r.data._id) pm.collectionVariables.set(\"productoId\", r.data._id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Teclado mecánico\",\n  \"precio\": 180000,\n  \"categoria\": \"Periféricos\",\n  \"stock\": 25\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/productos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "productos"
          ]
        }
      }
    },
    {
      "name": "1b. Crear producto (2)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Monitor 24\\\"\",\n  \"precio\": 650000,\n  \"categoria\": \"Pantallas\",\n  \"stock\": 10\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/productos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "productos"
          ]
        }
      }
    },
    {
      "name": "2. Listar productos",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/productos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "productos"
          ]
        }
      }
    },
    {
      "name": "3. Obtener producto por ID",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/productos/{{productoId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "productos",
            "{{productoId}}"
          ]
        }
      }
    },
    {
      "name": "4. Actualizar producto",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Teclado mecánico RGB\",\n  \"precio\": 200000,\n  \"categoria\": \"Periféricos\",\n  \"stock\": 30\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/productos/{{productoId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "productos",
            "{{productoId}}"
          ]
        }
      }
    },
    {
      "name": "6. Filtrar por categoría",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/productos/categoria/Periféricos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "productos",
            "categoria",
            "Periféricos"
          ]
        }
      }
    },
    {
      "name": "7. Registrar usuario",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Aprendiz SENA\",\n  \"email\": \"aprendiz@sena.edu.co\",\n  \"password\": \"123456\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/usuarios/registro",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "usuarios",
            "registro"
          ]
        }
      }
    },
    {
      "name": "8. Login usuario",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const r = pm.response.json();",
              "if (r.token) pm.collectionVariables.set(\"token\", r.token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"aprendiz@sena.edu.co\",\n  \"password\": \"123456\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/usuarios/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "usuarios",
            "login"
          ]
        }
      }
    },
    {
      "name": "9. Listar usuarios (requiere token)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/usuarios",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "usuarios"
          ]
        }
      }
    },
    {
      "name": "10. Estadísticas",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/reportes/estadisticas",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "reportes",
            "estadisticas"
          ]
        }
      }
    },
    {
      "name": "5. Eliminar producto",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/productos/{{productoId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "productos",
            "{{productoId}}"
          ]
        }
      }
    }
  ]
}